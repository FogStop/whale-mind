{
  "name": "whale-mind",
  "version": "0.1.0",
  "description": "给 DeepSeek Harness 一条会记事的鲸鱼娘：门控/固化/存储/检索/注入/衰减 六模块记忆引擎 + 三板可视化面板（记忆星脑/神经星环/记忆银河，一键切换）。零运行时依赖，无构建步骤。",
  "type": "module",
  "main": "src/cli.js",
  "icon": "assets/icon.svg",
  "scripts": {
    "demo": "node src/cli.js --demo",
    "selftest": "node src/cli.js --selftest",
    "start": "node src/cli.js",
    "panel": "node panel/server.mjs"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "files": [
    "src",
    "panel",
    "locale",
    "assets",
    "docs",
    "test",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "exports": {
    ".": "./src/plugin.mjs",
    "./client": "./panel/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg"
  }
}
